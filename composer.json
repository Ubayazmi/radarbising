{
    "name": "radarbising/radarbising",
    "description": "Radar Bising - Music Article & Video Platform",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "RadarBising\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}