# =============================================================================
# Radar Bising — Environment Configuration Template
#
# Safe to commit to GitHub: this file contains placeholders only.
# NEVER put real passwords, API keys, or tokens in this file.
#
# Local setup:
#   1. Copy this file to .env
#   2. Fill in the real values
#   3. Keep .env out of Git (.env must be in .gitignore)
#
# Vercel:
#   Add the required variables individually in:
#   Project → Settings → Environment Variables
# =============================================================================

# APPLICATION
# Use "local" for local development and "production" on Vercel.
APP_ENV=local
APP_DEBUG=true

# SUPABASE PROJECT / API
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public/anon key. Browser exposure is only appropriate when the app is
# designed for it and the database has suitable RLS policies.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Secret/service-role key: BACKEND ONLY.
# Never expose it in HTML, JavaScript, API responses, or logs.
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY

# POSTGRESQL — APPLICATION RUNTIME
# For Vercel/serverless, copy the exact host and username from:
# Supabase Dashboard → Connect → Transaction Pooler.
# Shared Transaction Pooler commonly uses port 6543 and username
# postgres.YOUR_PROJECT_REF. Confirm these details in the dashboard.
#
# Keep DB_DSN aligned with the variable name read by the application's PDO
# configuration. The user/password are included in this DSN template.
DB_DSN=pgsql:host=YOUR_TRANSACTION_POOLER_HOST;port=6543;dbname=postgres;user=postgres.YOUR_PROJECT_REF;password=YOUR_DATABASE_PASSWORD;sslmode=require

# SESSION SECURITY
# Generate a unique random value:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
SESSION_SECRET=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET

# FILE UPLOAD / SUPABASE STORAGE
# Bucket must exist in Supabase Storage and match the application config.
UPLOAD_DRIVER=supabase
SUPABASE_STORAGE_BUCKET=radarbising-uploads

# Optional; application may derive this from SUPABASE_URL.
# SUPABASE_STORAGE_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1

# SQLITE — LOCAL / ONE-TIME DATA MIGRATION ONLY
# Path to the legacy SQLite database when running locally.
# Do not use Vercel's filesystem for persistent uploads or database storage.
SQLITE_PATH=database.sqlite

# MIGRATION CONNECTION — OPTIONAL / CLI ONLY
# Intentionally commented out: migrate.php must explicitly support
# MIGRATION_DB_DSN before this variable can be used.
# If implemented, use a connection method supported by the environment
# running the migration. Direct Connection commonly uses port 5432.
# Do not add this variable to Vercel unless the deployed app needs it.
#
# MIGRATION_DB_DSN=pgsql:host=db.YOUR_PROJECT_REF.supabase.co;port=5432;dbname=postgres;user=postgres;password=YOUR_DATABASE_PASSWORD;sslmode=require

# VERCEL SYSTEM VARIABLES
# Vercel supplies these automatically; normally do not define them manually.
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=YOUR_PROJECT.vercel.app
# VERCEL_GIT_COMMIT_SHA=...
# VERCEL_GIT_REPO_SLUG=...

# OPTIONAL — ANALYTICS / MONITORING
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# SENTRY_DSN=https://...

# OPTIONAL — EMAIL (only if the application implements email delivery)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=YOUR_SMTP_USERNAME
# SMTP_PASSWORD=YOUR_SMTP_PASSWORD
# MAIL_FROM=noreply@example.com
