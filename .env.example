# =============================================================================
# Radar Bising — Environment Configuration
# Based on: Supabase Docs + Vercel Docs
# - Supabase: https://supabase.com/docs/guides/getting-started/tutorials/with-vercel
# - Vercel: https://vercel.com/docs/projects/environment-variables
# =============================================================================
# NEVER commit this file to version control!
# Production values are set in Vercel Dashboard → Project Settings → Environment Variables
# Local development: copy this file to .env.local (gitignored) and fill in values
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false

# -----------------------------------------------------------------------------
# SUPABASE PROJECT (Required)
# Source: Supabase Dashboard → Settings → API
# Docs: https://supabase.com/docs/guides/getting-started/tutorials/with-vercel#environment-variables
# -----------------------------------------------------------------------------
# Project URL (e.g., https://abcdefghijklmnop.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/Public Key (safe for client-side)
# Settings → API → Project API keys → anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (SECRET - server-side only, never expose to frontend)
# Settings → API → Project API keys → service_role secret
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# POSTGRESQL DATABASE CONNECTION (Required)
# Source: Supabase Dashboard → Settings → Database → Connection String
# Use "Transaction Pooler" (port 6543) for serverless/Vercel Functions
# Use "Direct Connection" (port 5432) for long-running scripts/migration
# Docs: https://supabase.com/docs/guides/database/connecting-to-postgres
# -----------------------------------------------------------------------------
# For Vercel Functions (serverless) — use Transaction Pooler:
# DB_DSN=pgsql:host=aws-0-region.pooler.supabase.com;port=6543;dbname=postgres;user=postgres.<ref>;password=***;sslmode=require

# For Migration Script / Local Dev — use Direct Connection:
DB_DSN=pgsql:host=db.your-project-ref.supabase.co;port=5432;dbname=postgres;user=postgres;password=***;sslmode=require

# Alternative: Connection URI format (also works with PDO)
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# -----------------------------------------------------------------------------
# SESSION HANDLING (Required for Plan 03)
# Generate: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
# 32 bytes = 64 hex chars
# -----------------------------------------------------------------------------
SESSION_SECRET=generate-64-hex-chars-here

# -----------------------------------------------------------------------------
# FILE UPLOAD / STORAGE (Required for Plan 03)
# Source: Supabase Dashboard → Storage
# Docs: https://supabase.com/docs/guides/storage
# -----------------------------------------------------------------------------
UPLOAD_DRIVER=supabase

# Bucket name (create in Supabase Dashboard → Storage → New Bucket)
# Public bucket for images: radarbising-uploads
SUPABASE_STORAGE_BUCKET=radarbising-uploads

# Storage URL (auto-derived from SUPABASE_URL if not set)
# SUPABASE_STORAGE_URL=https://your-project-ref.supabase.co/storage/v1

# -----------------------------------------------------------------------------
# SQLITE (Local Development Only)
# Source: project root database.sqlite
# -----------------------------------------------------------------------------
SQLITE_PATH=database.sqlite

# -----------------------------------------------------------------------------
# VERCEL-SPECIFIC (Auto-populated by Vercel, do not set manually)
# Docs: https://vercel.com/docs/projects/environment-variables#system-environment-variables
# -----------------------------------------------------------------------------
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=radarbising.vercel.app
# VERCEL_GIT_COMMIT_SHA=...
# VERCEL_GIT_REPO_SLUG=radarbising
# VERCEL_PROJECT_ID=...

# -----------------------------------------------------------------------------
# OPTIONAL: ANALYTICS / MONITORING
# -----------------------------------------------------------------------------
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# SENTRY_DSN=https://xxx@sentry.io/xxx

# -----------------------------------------------------------------------------
# OPTIONAL: EMAIL (if adding notifications later)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxx
# MAIL_FROM=noreply@radarbising.com